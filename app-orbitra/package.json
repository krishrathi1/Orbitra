{
  "name": "orbitra",
  "version": "1.0.3",
  "description": "Orbitra Browser",
  "main": "./out/main/index.js",
  "author": "Orbitra Browser Inc.",
  "homepage": "https://strawberrybrowser.com",
  "exports": {
    ".": "./out/main/index.js",
    "./spreadsheet/locale": "./src/shared/spreadsheet/locale.ts",
    "./workspace/layout-transition": "./src/shared/workspace/workspace-layout-transition.ts",
    "./workspace/types": "./src/shared/workspace/workspace.types.ts",
    "./workspace/layout-model": "./src/shared/layout/derive/model.ts",
    "./workspace/layout": "./src/shared/workspace/workspace-layout.ts"
  },
  "dependencies": {
